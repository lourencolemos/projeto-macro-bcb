# Copie para .streamlit/secrets.toml (ignorado pelo Git) e preencha.
# Use o host do POOLER do Supabase (a conexão direta costuma ser IPv6 e falha no Streamlit Cloud).
[connections.postgresql]
dialect = "postgresql"
host = "SEU_HOST_DO_POOLER"
port = 5432
database = "postgres"
username = "SEU_USUARIO"
password = "SUA_SENHA"
